{%- comment -%}
  Judge.me-backed reviews section.

  The markup below is byte-for-byte the layout this section has always had — the
  Judge.me widget's own DOM is deliberately not used, because it ships classes
  and a stylesheet that would override .rev-* typography and spacing.

  Data comes in at two different times:

  - The score, stars and review count render server-side from the Shopify
    product-rating metafields that Judge.me keeps in sync. No request, no shift.
  - Individual review bodies are not exposed to Liquid by Judge.me at all, so
    100cal-judgeme-reviews.js fills the three cards after paint. Every card
    keeps its authored copy until a real review is available to replace it, so
    a fetch failure degrades to exactly what this section rendered before.
{%- endcomment -%}

{%- liquid
  assign jm_count = product.metafields.reviews.rating_count.value | plus: 0
  assign jm_rating = product.metafields.reviews.rating.value.rating
  assign jm_has_reviews = false
  if product != blank and jm_count > 0
    assign jm_has_reviews = true
  endif

  # The "read more" links expand the grid in place, three reviews at a time.
  # They stay anchors so the .rev-cta-link / .rev-footer-link styling still
  # applies, and they fall back to the section's own anchor so a click without
  # JS is a harmless no-op rather than a broken navigation. Setting cta_link
  # opts out and navigates.
  assign jm_cta_link = section.settings.cta_link | default: '#reviews'

  # Three reviews fill the grid on load, so a product with no more than that
  # has nothing to expand into and the links are left out rather than rendered
  # and then hidden by the script once it has looked. A count of zero means
  # Judge.me has not synced the metafield, not that there are no reviews — the
  # script still asks the endpoint, so the links stay for it to hide.
  assign jm_can_expand = true
  if jm_has_reviews and jm_count <= 3
    assign jm_can_expand = false
  endif
  if section.settings.cta_link != blank
    assign jm_can_expand = true
  endif
-%}

<section class="reviews-section" id="reviews">
  <div class="rev-inner">
    <div class="rev-header">
      <div style="display:flex;align-items:center;gap:24px">
        <div class="rev-big-num">{% if jm_has_reviews %}{{ jm_rating | round: 1 }}{% else %}{{ section.settings.review_score }}{% endif %}</div>
        <div>
          <span class="rev-stars">{% if jm_has_reviews %}{% render 'judgeme-stars', rating: jm_rating %}{% else %}{{ section.settings.review_stars }}{% endif %}</span>
          <div class="rev-count">{{ section.settings.review_count_text | replace: '[count]', jm_count }}</div>
          <div class="rev-headline">{{ section.settings.review_headline }}</div>
        </div>
      </div>
      {%- if jm_can_expand -%}
        <a href="{{ jm_cta_link }}" class="rev-cta-link"{% if section.settings.cta_link == blank %} data-judgeme-more{% endif %}>{{ section.settings.review_cta }}</a>
      {%- endif -%}
    </div>
    <div
      class="rev-grid"
      data-judgeme-reviews
      data-product-id="{{ product.id }}"
      data-shop-domain="{{ shop.permanent_domain }}"
      data-product-title="{{ product.title | escape }}"
      data-verified-label="{{ section.settings.verified_label | escape }}"
      data-min-rating="{{ section.settings.min_rating }}"
    >
      <div class="rev-card" data-judgeme-card>
        <span class="r-tag r-tag-gut">{{ section.settings.review_1_tag }}</span>
        <div class="r-stars">{{ section.settings.review_1_stars }}</div>
        <p class="r-quote">{{ section.settings.review_1_quote }}</p>
        <div class="r-name">{{ section.settings.review_1_name }}</div>
        <div class="r-product">{{ section.settings.review_1_product }}</div>
      </div>
      <div class="rev-card" data-judgeme-card>
        <span class="r-tag r-tag-crav">{{ section.settings.review_2_tag }}</span>
        <div class="r-stars">{{ section.settings.review_2_stars }}</div>
        <p class="r-quote">{{ section.settings.review_2_quote }}</p>
        <div class="r-name">{{ section.settings.review_2_name }}</div>
        <div class="r-product">{{ section.settings.review_2_product }}</div>
      </div>
      <div class="rev-card" data-judgeme-card>
        <span class="r-tag r-tag-energy">{{ section.settings.review_3_tag }}</span>
        <div class="r-stars">{{ section.settings.review_3_stars }}</div>
        <p class="r-quote">{{ section.settings.review_3_quote }}</p>
        <div class="r-name">{{ section.settings.review_3_name }}</div>
        <div class="r-product">{{ section.settings.review_3_product }}</div>
      </div>
    </div>
    {%- if jm_can_expand -%}
      <div class="rev-footer">
        <a href="{{ jm_cta_link }}" class="rev-footer-link"{% if section.settings.cta_link == blank %} data-judgeme-more{% endif %}>{{ section.settings.review_footer_cta | replace: '[count]', jm_count }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{%- comment -%}
  Judge.me ships the review widget's payload as a product metafield on stores
  that have it enabled. When it is there the cards fill with no network request
  at all; the script falls back to Judge.me's widget endpoint when it is not.
{%- endcomment -%}
{%- if product.metafields.judgeme.review_widget_data != blank -%}
  <script type="application/json" data-judgeme-widget-data>{{ product.metafields.judgeme.review_widget_data }}</script>
{%- endif -%}

<script src="{{ '100cal-judgeme-reviews.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "100Cal Reviews",
  "settings": [
    { "type": "paragraph", "content": "Score, stars and review count come from Judge.me automatically. Use [count] in the text fields below to print the live review count. The three review cards are replaced with real Judge.me reviews when the product has them — the copy saved here is the fallback shown until then." },
    { "type": "url", "id": "cta_link", "label": "\"Read more\" link", "info": "Leave empty — the Read More links then load the next three reviews into this section without leaving the page, and disappear once every review is shown. Set a URL only if you want them to navigate away instead." },
    { "type": "range", "id": "min_rating", "label": "Minimum star rating to feature", "min": 1, "max": 5, "step": 1, "default": 4 },
    { "type": "text", "id": "verified_label", "label": "Verified buyer label", "default": "Verified Purchase" },
    { "type": "text", "id": "review_score", "label": "Review score (fallback)", "default": "4.9" },
    { "type": "text", "id": "review_stars", "label": "Review stars (fallback)", "default": "★★★★★" },
    { "type": "text", "id": "review_count_text", "label": "Review count text", "default": "Based on [count] reviews" },
    { "type": "text", "id": "review_headline", "label": "Review headline", "default": "Real People. Real Results." },
    { "type": "text", "id": "review_cta", "label": "Review CTA", "default": "Read All Reviews →" },
    { "type": "text", "id": "review_1_tag", "label": "Review 1 tag", "default": "Gut Health" },
    { "type": "text", "id": "review_1_stars", "label": "Review 1 stars (fallback)", "default": "★★★★★" },
    { "type": "textarea", "id": "review_1_quote", "label": "Review 1 quote (fallback)", "default": "\"I've struggled with bloating from every protein bar I've ever tried. These are the first ones that actually made my gut feel better, not worse. I'm obsessed.\"" },
    { "type": "text", "id": "review_1_name", "label": "Review 1 name (fallback)", "default": "Sarah M. · Los Angeles" },
    { "type": "text", "id": "review_1_product", "label": "Review 1 product (fallback)", "default": "Verified Purchase" },
    { "type": "text", "id": "review_2_tag", "label": "Review 2 tag", "default": "Craving Control" },
    { "type": "text", "id": "review_2_stars", "label": "Review 2 stars (fallback)", "default": "★★★★★" },
    { "type": "textarea", "id": "review_2_quote", "label": "Review 2 quote (fallback)", "default": "\"I was stress eating every afternoon. Two weeks in with these and I genuinely don't reach for the vending machine anymore. The ashwagandha is not a gimmick.\"" },
    { "type": "text", "id": "review_2_name", "label": "Review 2 name (fallback)", "default": "Priya K. · New York" },
    { "type": "text", "id": "review_2_product", "label": "Review 2 product (fallback)", "default": "Verified Purchase · Subscribe & Save" },
    { "type": "text", "id": "review_3_tag", "label": "Review 3 tag", "default": "Macro-Friendly" },
    { "type": "text", "id": "review_3_stars", "label": "Review 3 stars (fallback)", "default": "★★★★★" },
    { "type": "textarea", "id": "review_3_quote", "label": "Review 3 quote (fallback)", "default": "\"100 clean calories, tastes like dessert. I stopped buying protein bars from anyone else. The texture alone is worth it — it actually chews like a real brownie.\"" },
    { "type": "text", "id": "review_3_name", "label": "Review 3 name (fallback)", "default": "Mike T. · Chicago" },
    { "type": "text", "id": "review_3_product", "label": "Review 3 product (fallback)", "default": "Verified Purchase" },
    { "type": "text", "id": "review_footer_cta", "label": "Review footer CTA", "default": "Read More →" }
  ],
  "presets": [
    { "name": "Reviews" }
  ]
}
{% endschema %}
