{{ '100cal-sections.css' | asset_url | stylesheet_tag }}

{%- paginate search.results by 12 -%}

<div class="hcsr-wrap">
  <div class="hcsr-inner">

    <!-- Search header -->
    <div class="hcsr-head">
      {%- if search.performed -%}
        <h1 class="hcsr-title">
          {%- if search.results_count > 0 -%}
            {{ search.results_count }} Result{% if search.results_count != 1 %}s{% endif %} for &ldquo;{{ search.terms | escape }}&rdquo;
          {%- else -%}
            No results for &ldquo;{{ search.terms | escape }}&rdquo;
          {%- endif -%}
        </h1>
      {%- else -%}
        <h1 class="hcsr-title">Search</h1>
      {%- endif -%}
    </div>

    <!-- Search form -->
    <form action="/search" method="get" class="hcsr-form" role="search">
      <input type="hidden" name="type" value="product,article">
      <div class="hcsr-field">
        <svg class="hcsr-field-icon" width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <circle cx="8.5" cy="8.5" r="5.75" stroke="currentColor" stroke-width="1.8"/>
          <path d="M13.5 13.5L17.5 17.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
        <input
          type="search"
          name="q"
          class="hcsr-input"
          value="{{ search.terms | escape }}"
          placeholder="Search products, articles…"
          aria-label="Search"
          autocomplete="off"
          autocorrect="off"
          spellcheck="false"
        >
        <button type="submit" class="hcsr-submit">Search</button>
      </div>
    </form>

    {%- if search.performed -%}
      {%- if search.results_count == 0 -%}

        <!-- Empty state -->
        <div class="hcsr-empty">
          <div class="hcsr-empty-icon">🔍</div>
          <p class="hcsr-empty-msg">We couldn&rsquo;t find anything matching &ldquo;<strong>{{ search.terms | escape }}</strong>&rdquo;.</p>
          <p class="hcsr-empty-sub">Try different keywords or browse our products below.</p>
          <a href="{{ routes.all_products_collection_url }}" class="hcsr-btn">Shop All Products</a>
        </div>

      {%- else -%}

        {%- comment -%} Partition results into products and articles {%- endcomment -%}
        {%- assign sr_products = search.results | where: 'object_type', 'product' -%}
        {%- assign sr_articles = search.results | where: 'object_type', 'article' -%}

        <!-- Products -->
        {%- if sr_products.size > 0 -%}
          <div class="hcsr-section">
            <div class="hcsr-section-label">Products</div>
            <div class="hcsr-product-grid">
              {%- for product in sr_products -%}
                <a class="hcsr-card" href="{{ product.url }}">
                  <div class="hcsr-card-img">
                    {%- if product.featured_image -%}
                      {{ product.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: product.title }}
                    {%- else -%}
                      <span class="hcsr-card-placeholder">🍫</span>
                    {%- endif -%}
                    {%- if product.compare_at_price > product.price -%}
                      <span class="hcsr-card-badge">Sale</span>
                    {%- endif -%}
                  </div>
                  <div class="hcsr-card-body">
                    <div class="hcsr-card-title">{{ product.title | escape }}</div>
                    {%- if product.vendor -%}
                      <div class="hcsr-card-vendor">{{ product.vendor | escape }}</div>
                    {%- endif -%}
                    <div class="hcsr-card-price">
                      {%- if product.compare_at_price > product.price -%}
                        <span class="hcsr-price-sale">{{ product.price | money }}</span>
                        <span class="hcsr-price-orig">{{ product.compare_at_price | money }}</span>
                      {%- else -%}
                        {{ product.price | money }}
                      {%- endif -%}
                    </div>
                  </div>
                </a>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        <!-- Articles -->
        {%- if sr_articles.size > 0 -%}
          <div class="hcsr-section">
            <div class="hcsr-section-label">Articles</div>
            <div class="hcsr-article-grid">
              {%- for article in sr_articles -%}
                <a class="hcsr-article-card" href="{{ article.url }}">
                  {%- if article.image -%}
                    <div class="hcsr-article-img">
                      {{ article.image | image_url: width: 480 | image_tag: loading: 'lazy', alt: article.title }}
                    </div>
                  {%- endif -%}
                  <div class="hcsr-article-body">
                    {%- if article.blog -%}
                      <div class="hcsr-article-blog">{{ article.blog.title | escape }}</div>
                    {%- endif -%}
                    <div class="hcsr-article-title">{{ article.title | escape }}</div>
                    {%- if article.excerpt_or_content != blank -%}
                      <p class="hcsr-article-excerpt">{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p>
                    {%- endif -%}
                    <div class="hcsr-article-meta">
                      {%- if article.published_at -%}
                        <span>{{ article.published_at | date: '%b %d, %Y' }}</span>
                      {%- endif -%}
                      {%- if article.author -%}
                        <span>{{ article.author | escape }}</span>
                      {%- endif -%}
                    </div>
                  </div>
                </a>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        <!-- Pagination -->
        {%- if paginate.pages > 1 -%}
          <div class="hcsr-pagination">
            {%- if paginate.previous -%}
              <a class="hcsr-page-btn" href="{{ paginate.previous.url }}">&larr; Previous</a>
            {%- endif -%}
            <span class="hcsr-page-info">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
            {%- if paginate.next -%}
              <a class="hcsr-page-btn" href="{{ paginate.next.url }}">Next &rarr;</a>
            {%- endif -%}
          </div>
        {%- endif -%}

      {%- endif -%}
    {%- endif -%}

  </div>
</div>

{%- endpaginate -%}

{% stylesheet %}
/* ── 100Cal Search Page ───────────────────────────────────────── */

.hcsr-wrap {
  background: var(--neutral);
  min-height: 60vh;
  padding: 56px 0 80px;
}

.hcsr-inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 24px;
}

/* Head */
.hcsr-head {
  margin-bottom: 32px;
}

.hcsr-title {
  font-family: var(--font-head);
  font-size: clamp(28px, 5vw, 44px);
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: var(--black);
  margin: 0;
  line-height: 1.1;
}

/* Search form */
.hcsr-form {
  margin-bottom: 48px;
}

.hcsr-field {
  display: flex;
  align-items: center;
  background: #fff;
  border: 2px solid var(--black);
  border-radius: 8px;
  max-width: 680px;
  overflow: hidden;
  transition: border-color 0.15s;
}

.hcsr-field:focus-within {
  border-color: var(--teal);
}

.hcsr-field-icon {
  flex-shrink: 0;
  margin: 0 12px;
  color: #888;
}

.hcsr-input {
  flex: 1;
  border: none;
  outline: none;
  background: transparent;
  font-family: var(--font-body, sans-serif);
  font-size: 16px;
  color: var(--black);
  padding: 14px 0;
  min-width: 0;
}

.hcsr-input::placeholder { color: #aaa; }

.hcsr-input::-webkit-search-cancel-button { display: none; }

.hcsr-submit {
  flex-shrink: 0;
  background: var(--black);
  color: #fff;
  border: none;
  font-family: var(--font-head);
  font-size: 14px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1px;
  padding: 0 24px;
  height: 52px;
  cursor: pointer;
  transition: background 0.15s;
}

.hcsr-submit:hover { background: var(--teal); color: var(--black); }

/* Section labels */
.hcsr-section {
  margin-bottom: 56px;
}

.hcsr-section-label {
  font-family: var(--font-head);
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 2px;
  color: var(--teal-dark, #3A9999);
  margin-bottom: 20px;
}

/* Product grid */
.hcsr-product-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 20px;
}

.hcsr-card {
  display: block;
  background: #fff;
  border-radius: 12px;
  overflow: hidden;
  text-decoration: none;
  color: var(--black);
  transition: transform 0.18s, box-shadow 0.18s;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
}

.hcsr-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 24px rgba(0,0,0,0.12);
}

.hcsr-card-img {
  position: relative;
  aspect-ratio: 1;
  background: var(--neutral-light, #EAE9E5);
  overflow: hidden;
}

.hcsr-card-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.3s;
}

.hcsr-card:hover .hcsr-card-img img { transform: scale(1.04); }

.hcsr-card-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  font-size: 48px;
}

.hcsr-card-badge {
  position: absolute;
  top: 10px;
  left: 10px;
  background: var(--teal);
  color: var(--black);
  font-family: var(--font-head);
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1px;
  padding: 3px 8px;
  border-radius: 4px;
}

.hcsr-card-body {
  padding: 14px 16px 18px;
}

.hcsr-card-title {
  font-family: var(--font-head);
  font-size: 17px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: var(--black);
  line-height: 1.2;
  margin-bottom: 4px;
}

.hcsr-card-vendor {
  font-size: 12px;
  color: #888;
  margin-bottom: 8px;
}

.hcsr-card-price {
  font-family: var(--font-head);
  font-size: 16px;
  font-weight: 700;
  color: var(--black);
  display: flex;
  align-items: center;
  gap: 8px;
}

.hcsr-price-sale { color: var(--teal-dark, #3A9999); }

.hcsr-price-orig {
  font-size: 13px;
  font-weight: 400;
  color: #aaa;
  text-decoration: line-through;
}

/* Article grid */
.hcsr-article-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 24px;
}

.hcsr-article-card {
  display: flex;
  flex-direction: column;
  background: #fff;
  border-radius: 12px;
  overflow: hidden;
  text-decoration: none;
  color: var(--black);
  transition: transform 0.18s, box-shadow 0.18s;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
}

.hcsr-article-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 24px rgba(0,0,0,0.12);
}

.hcsr-article-img {
  aspect-ratio: 16/9;
  overflow: hidden;
  background: var(--neutral-light, #EAE9E5);
}

.hcsr-article-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.3s;
}

.hcsr-article-card:hover .hcsr-article-img img { transform: scale(1.04); }

.hcsr-article-body {
  padding: 18px 20px 20px;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.hcsr-article-blog {
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 2px;
  color: var(--teal-dark, #3A9999);
  margin-bottom: 8px;
}

.hcsr-article-title {
  font-family: var(--font-head);
  font-size: 20px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: var(--black);
  line-height: 1.2;
  margin-bottom: 10px;
}

.hcsr-article-excerpt {
  font-size: 14px;
  color: #555;
  line-height: 1.5;
  margin: 0 0 12px;
  flex: 1;
}

.hcsr-article-meta {
  font-size: 12px;
  color: #aaa;
  display: flex;
  gap: 12px;
  margin-top: auto;
}

/* Empty state */
.hcsr-empty {
  text-align: center;
  padding: 64px 24px;
}

.hcsr-empty-icon {
  font-size: 60px;
  margin-bottom: 20px;
}

.hcsr-empty-msg {
  font-family: var(--font-head);
  font-size: 24px;
  font-weight: 700;
  text-transform: uppercase;
  color: var(--black);
  margin: 0 0 10px;
}

.hcsr-empty-sub {
  font-size: 16px;
  color: #666;
  margin: 0 0 28px;
}

.hcsr-btn {
  display: inline-block;
  background: var(--black);
  color: #fff;
  font-family: var(--font-head);
  font-size: 14px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1px;
  padding: 14px 32px;
  border-radius: 6px;
  text-decoration: none;
  transition: background 0.15s, color 0.15s;
}

.hcsr-btn:hover { background: var(--teal); color: var(--black); }

/* Pagination */
.hcsr-pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20px;
  margin-top: 48px;
  flex-wrap: wrap;
}

.hcsr-page-btn {
  display: inline-block;
  background: var(--black);
  color: #fff;
  font-family: var(--font-head);
  font-size: 13px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1px;
  padding: 10px 24px;
  border-radius: 6px;
  text-decoration: none;
  transition: background 0.15s, color 0.15s;
}

.hcsr-page-btn:hover { background: var(--teal); color: var(--black); }

.hcsr-page-info {
  font-size: 14px;
  color: #777;
}

/* Responsive */
@media (max-width: 599px) {
  .hcsr-product-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .hcsr-article-grid {
    grid-template-columns: 1fr;
  }

  .hcsr-submit {
    padding: 0 16px;
    font-size: 13px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Search",
  "tag": "section",
  "class": "section"
}
{% endschema %}
